# Rust API + local single-user development. No Supabase settings required.
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_AUTH_MODE=local

# Later, for Supabase sign-in:
# VITE_AUTH_MODE=supabase
# VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Remove VITE_API_BASE_URL for the original browser-only localStorage game.
# Never put a database password or a service_role/secret key in this file.

# Production canonical origin; leave unset locally (noindex).
# VITE_SITE_URL=https://your-domain.com
