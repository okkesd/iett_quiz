# Copy to deploy/.env for manual deployment. GitHub Actions generates this file.
QUIZ_DOMAIN=iettquiz.duckdns.org
IMAGE_PREFIX=your-dockerhub-username
RELEASE_TAG=first-release
# offline: no account, browser progress. server: Supabase Auth + Rust + SQLite.
DEPLOY_MODE=offline
# Resolve app-network from the running nginx; do not guess its Compose prefix.
EDGE_NETWORK=auto
EDGE_CONTAINER=nginx
# Leave empty for $HOME/docker-app (the location used by Club Events workflows).
EDGE_STACK_DIR=
# server mode only: a public/publishable key, never service_role or sb_secret_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
